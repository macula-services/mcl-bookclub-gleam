{application,reckon_gater,
             [{description,"Gateway for reckon-db event store with capability-based security"},
              {vsn,"3.11.2"},
              {registered,[]},
              {mod,{reckon_gater_app,[]}},
              {applications,[kernel,stdlib,crypto,telemetry]},
              {env,[{cluster,[{port,45893},{multicast_addr,{239,255,0,2}}]},
                    {retry,[{base_delay_ms,100},
                            {max_delay_ms,30000},
                            {max_retries,10}]}]},
              {modules,[reckon_gater_api,reckon_gater_app,
                        reckon_gater_canonical,reckon_gater_capability,
                        reckon_gater_channel,reckon_gater_channel_alerts,
                        reckon_gater_channel_audit,
                        reckon_gater_channel_diagnostics,
                        reckon_gater_channel_events,
                        reckon_gater_channel_health,
                        reckon_gater_channel_lifecycle,
                        reckon_gater_channel_logging,
                        reckon_gater_channel_metrics,
                        reckon_gater_channel_security,
                        reckon_gater_channel_server,reckon_gater_channel_sup,
                        reckon_gater_channel_system,
                        reckon_gater_cluster_monitor,reckon_gater_cluster_sup,
                        reckon_gater_config,reckon_gater_crypto_nif,
                        reckon_gater_identity,reckon_gater_integrity,
                        reckon_gater_pubsub_security,reckon_gater_repl,
                        reckon_gater_retry,reckon_gater_stream_id,
                        reckon_gater_sup,reckon_gater_telemetry,
                        reckon_gater_uuid,reckon_gater_worker_registry]},
              {licenses,["Apache-2.0"]},
              {links,[{"GitHub",
                       "https://github.com/reckon-db-org/reckon-gater"}]}]}.
