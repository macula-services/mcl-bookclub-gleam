{application,mcl_om,
             [{description,"PQ-only over-mesh substrate for the macula-services/mcl-* daemons"},
              {vsn,"0.29.1"},
              {registered,[mcl_om_sup]},
              {mod,{mcl_om_app,[]}},
              {applications,[kernel,stdlib,crypto,cowboy,jsx,macula,reckon_db,
                             evoq,reckon_evoq]},
              {env,[{service_cert_path,"/etc/hecate/secrets/service-cert.pem"},
                    {station_seeds,[]},
                    {health_port,8470},
                    {health_ip,undefined},
                    {capability_topic,<<"_mesh.cap.">>}]},
              {modules,[mcl_om,mcl_om_advertise_liveness,mcl_om_app,
                        mcl_om_capabilities,mcl_om_claim,mcl_om_content,
                        mcl_om_content_downloader,mcl_om_content_feeder,
                        mcl_om_describe,mcl_om_health,mcl_om_health_handler,
                        mcl_om_identity,mcl_om_info,mcl_om_ownership_proof,
                        mcl_om_provider_grant,mcl_om_pubsub,
                        mcl_om_pubsub_subscriptions,mcl_om_pubsub_sup,
                        mcl_om_service,mcl_om_simple_handler,mcl_om_store,
                        mcl_om_sup,mcl_om_wire]},
              {licenses,["Apache-2.0"]},
              {links,[{"GitHub",
                       "https://github.com/macula-services/mcl-om"}]}]}.
