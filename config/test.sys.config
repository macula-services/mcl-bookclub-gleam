%% test.sys.config: the test environment for the Gleam twin.
%%
%% Loaded by scripts/test.sh (the gleam test wrapper -- `gleam test` alone
%% cannot pass config to erl, and without macula's crypto profile the test
%% VM refuses to start the macula app that mcl_om pulls in). Mirrors the
%% Erlang twin's `rebar3 eunit` test profile.
[
    {kernel, [{logger_level, warning}]},
    %% NO `puzzle_difficulty' HERE. macula 12 makes it one fleet constant
    %% and REFUSES a `{macula, puzzle_difficulty, _}' setting.
    {macula, [
        %% THE SUITE'S OWN IDENTITY, NOT THE ACCOUNT'S. Unset, macula stores a
        %% node identity in the account's per-user directory, so the tests would
        %% read (and on a fresh machine write) the operator's own key. macula#76
        %% refuses the old node_identity_path setting.
        {identity_dir, "build/test/identity"},
        {crypto_profile, pq_hybrid}
    ]}
].
