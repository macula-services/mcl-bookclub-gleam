%% rebar3 configuration for mcl-bookclub-gleam.
%%
%% The Gleam toolchain owns compilation (gleam build resolves and compiles
%% everything, including the hex Erlang deps). rebar3's role here is exactly
%% one provider: `rebar3 release`, whose relx step ASSEMBLES the release from
%% the prebuilt apps staged by scripts/release.sh (build/release-libs).
%%
%% The project declares NO apps of its own ({project_app_dirs, []}): there is
%% nothing for rebar3 to compile, and no duplicate app shadowing the staged,
%% patched one. ERL_LIBS=build/dev/erlang makes the ffi's -include_lib
%% resolve should anything ever ask rebar3 to compile src/.
{deps, []}.

{project_app_dirs, []}.

{profiles, [
    {prod, [{erl_opts, [no_debug_info]}]}
]}.

{relx, [
    {release, {mcl_bookclub_gleam, "0.1.0"}, [mcl_bookclub_gleam, sasl]},
    {sys_config_src, "config/sys.config.src"},
    {vm_args_src, "config/vm.args.src"},
    {extended_start_script, true},
    {mode, prod},
    {include_erts, true},
    {include_src, false},
    {debug_info, strip},
    %% The apps come PREBUILT from `gleam build` (Gleam compiles the Erlang
    %% deps itself). scripts/release.sh stages a patched copy here: the .app
    %% gains its mod entry, the test beams and the gleeunit dev dep are
    %% stripped, and priv/ (the admin UI) is copied in.
    {lib_dirs, ["build/release-libs"]},
    {output_dir, "_build/release"}
]}.
