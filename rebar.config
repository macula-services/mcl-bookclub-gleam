%% rebar3 configuration for mcl-bookclub-gleam.
%%
%% The Gleam toolchain owns compilation (gleam build resolves and compiles
%% everything, including the hex Erlang deps). rebar3's role here is exactly
%% one provider: `rebar3 release`, whose relx step ASSEMBLES the release from
%% the prebuilt apps staged by scripts/release.sh (build/release-libs).
%%
%% The project declares NO apps of its own ({project_app_dirs, []}): there is
%% nothing for rebar3 to compile, and no duplicate app shadowing the staged,
%% patched one. ERL_LIBS=build/dev/erlang makes the ffi's -include_lib
%% resolve should anything ever ask rebar3 to compile src/.
{deps, []}.

{project_app_dirs, []}.

%% The org's structural ruleset, matching the sibling services. The Gleam
%% sources compile to Erlang under build/dev/erlang, and the generated code
%% mirrors the source's case nesting -- so elvis enforces the SAME
%% no_deep_nesting/no_nested_try_catch/no_if_expression rules on the Gleam
%% twin that it enforces on the Erlang twin.
%%
%% scripts/lint.sh runs elvis DIRECTLY with this config (an explicit
%% in-memory {config, [...]} argument). It deliberately does NOT go through
%% rebar3_lint: elvis_core >= 5.0 injects `git check-ignore` output into
%% every rule group's ignore list when it reads its config from a file, so
%% any glob under build/ (git-ignored, as gleam's output must be) would be
%% silently filtered and the gate would lint nothing. The direct invocation
%% skips that injection and lints the generated artefacts in place.
%%
%% Like the twins (which lint only apps/*/src/**), the gate covers the
%% non-test modules only: *_test and test_support are excluded.
{elvis, [
    {rulesets, #{
        mcl_min => [
            {elvis_style, no_deep_nesting, #{level => 2}},
            {elvis_style, no_nested_try_catch, #{}},
            {elvis_style, no_if_expression, #{}}
        ]
    }},
    {config, [
        #{files => ["build/dev/erlang/mcl_bookclub_gleam/_gleam_artefacts/*.erl"],
          ignore => ["_test[.]erl$", "test_support[.]erl$"],
          ruleset => mcl_min},
        %% The FFI is hand-written Erlang; it follows the same rules.
        #{files => ["src/mcl_bookclub_gleam_ffi.erl"],
          ruleset => mcl_min}
    ]}
]}.

{profiles, [
    {prod, [{erl_opts, [no_debug_info]}]}
]}.

{relx, [
    {release, {mcl_bookclub_gleam, "0.1.0"}, [mcl_bookclub_gleam, sasl]},
    {sys_config_src, "config/sys.config.src"},
    {vm_args_src, "config/vm.args.src"},
    {extended_start_script, true},
    {mode, prod},
    {include_erts, true},
    {include_src, false},
    {debug_info, strip},
    %% The apps come PREBUILT from `gleam build` (Gleam compiles the Erlang
    %% deps itself). scripts/release.sh stages a patched copy here: the .app
    %% gains its mod entry, the test beams and the gleeunit dev dep are
    %% stripped, and priv/ (the admin UI) is copied in.
    {lib_dirs, ["build/release-libs"]},
    {output_dir, "_build/release"}
]}.
